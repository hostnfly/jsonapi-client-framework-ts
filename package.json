{
  "name": "jsonapi-client-framework-ts",
  "version": "0.1.0",
  "description": "An object-oriented framework for JSON:API clients.",
  "license": "MIT",
  "author": "HostnFly",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hostnfly/jsonapi-client-framework-ts.git"
  },
  "homepage": "https://github.com/hostnfly/jsonapi-client-framework-ts",
  "bugs": {
    "url": "https://github.com/hostnfly/jsonapi-client-framework-ts/issues"
  },
  "keywords": [
    "jsonapi"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
